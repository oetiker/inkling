{
	"name": "lt-local-extension",
	"displayName": "Local Grammar Checker for LanguageTool",
	"version": "0.1.0",
	"author": "Tobias Oetiker",
	"description": "Checks what you write in the browser with your own LanguageTool server",
	"type": "module",
	"license": "Apache-2.0",
	"keywords": [
		"chrome-extension",
		"languagetool",
		"grammar"
	],
	"engines": {
		"node": ">=14.18.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build -l warn",
		"check": "pnpm check:typescript && pnpm check:config && pnpm check:svelte",
		"check:typescript": "tsc --noEmit --project tsconfig.json",
		"check:config": "tsc --noEmit --project tsconfig.node.json",
		"check:svelte": "svelte-check --tsconfig ./tsconfig.json",
		"preview": "vite preview",
		"zip-for-chrome": "TARGET_BROWSER=chrome pnpm run build && node src/zip.js lt-local-chrome.zip",
		"zip-for-firefox": "TARGET_BROWSER=firefox pnpm run build && node src/zip.js lt-local-firefox.zip",
		"test": "playwright test --headed",
		"test:unit": "node --test --experimental-transform-types --disable-warning=ExperimentalWarning 'unit/*.test.ts'"
	},
	"devDependencies": {
		"@crxjs/vite-plugin": "^2.3.0",
		"@playwright/test": "1.60.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@tailwindcss/vite": "^4.1.4",
		"@types/chrome": "^0.0.246",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "catalog:",
		"flowbite": "^3.1.2",
		"gulp": "^5.0.0",
		"gulp-zip": "^6.0.0",
		"http-server": "^14.1.1",
		"playwright": "1.60.0",
		"playwright-webextext": "^0.0.5",
		"svelte": "^5.0.0",
		"svelte-check": "^4.3.3",
		"svelte-preprocess": "^6.0.0",
		"tailwindcss": "^4.1.4",
		"tslib": "^2.6.2",
		"typescript": "^5.5.0",
		"vite": "^5.4.10"
	},
	"dependencies": {
		"@fortawesome/free-solid-svg-icons": "^7.1.0",
		"@webcomponents/custom-elements": "^1.6.0",
		"components": "workspace:*",
		"lint-framework": "workspace:*",
		"lodash-es": "^4.17.21",
		"lru-cache": "^11.1.0",
		"svelte-fa": "^4.0.4"
	}
}
