{
	"name": "inkling",
	"displayName": "Inkling",
	"version": "0.1.2",
	"author": "Tobias Oetiker",
	"description": "Checks what you write in the browser with your own LanguageTool server",
	"type": "module",
	"license": "Apache-2.0",
	"keywords": [
		"chrome-extension",
		"languagetool",
		"grammar"
	],
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build -l warn",
		"check": "pnpm check:typescript && pnpm check:config && pnpm check:svelte",
		"check:typescript": "tsc --noEmit --project tsconfig.json",
		"check:config": "tsc --noEmit --project tsconfig.node.json",
		"check:svelte": "svelte-check --tsconfig ./tsconfig.json",
		"preview": "vite preview",
		"zip-for-chrome": "TARGET_BROWSER=chrome pnpm run build && node src/zip.js inkling-chrome.zip",
		"zip-for-firefox": "TARGET_BROWSER=firefox pnpm run build && node src/zip.js inkling-firefox.zip",
		"test": "playwright test --headed",
		"test:unit": "node --test --experimental-transform-types --disable-warning=ExperimentalWarning 'unit/*.test.ts'"
	},
	"devDependencies": {
		"@crxjs/vite-plugin": "^3.0.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.57.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/chrome": "^0.3.5",
		"@types/node": "catalog:",
		"bits-ui": "^2.19.5",
		"cn": "^0.4.0",
		"fflate": "^0.8.3",
		"http-server": "^14.1.1",
		"playwright": "1.64.1",
		"playwright-webextext": "^0.0.5",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"lint-framework": "workspace:*",
		"lru-cache": "^11.5.3"
	}
}
